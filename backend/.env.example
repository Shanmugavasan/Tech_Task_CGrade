# Copy this file to .env for local development.
OPENAI_API_KEY=replace-with-your-openai-key
ENVIRONMENT=development

# Optional encryption for newly persisted sensitive fields.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional bearer-token mode. The browser demo login works when these are unset in development.
# AUTH_TOKEN=replace-with-a-long-random-token
# AUTH_USER_ID=demo-handler
# AUTH_ROLE=handler
# AUTH_HANDLER_TYPES=Claims,Motor,Home,Liability,Finance

# Optional JSON user mapping for token-based multi-user development.
# AUTH_USERS_JSON=[{"token":"local-secret","user_id":"home-handler-1","role":"handler","handler_types":["Home"]}]

# Default retention period used by the admin purge endpoint.
RETENTION_DAYS=365

# Optional Langfuse observability.
# LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
# LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PROJECT_URL=https://cloud.langfuse.com
